# Ejemplo de variables de entorno
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx   # opcional, mejora rate limits de GitHub Search
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_WEBHOOK_URL=
# PostgreSQL externo (obligatorio). El dashboard y el worker no usan SQLite.
DATABASE_URL=postgresql://user:pass@host:5432/humo
CVE_LIST_PATH=./data/cvelistV5
SYNC_INTERVAL_MINUTES=15

# Panel SOC (/soc): no es público. Sin SOC_PASSWORD el login queda cerrado.
# Generá una clave larga (p.ej. python -c "import secrets; print(secrets.token_hex(16))").
SOC_USER=soc
SOC_PASSWORD=
# 1 cuando se accede por HTTPS (también detrás de un proxy/túnel); 0 para HTTP local.
SOC_COOKIE_SECURE=0

# CIRCL: solo los autores revisados de esta lista pueden confirmar explotación.
# Los demás sightings se guardan como evidencia no verificada. Vacío = ninguno.
CIRCL_TRUSTED_AUTHORS=

# LLM — proveedor y modelo configurables (env pisa config/llm.yaml).
# litellm → http://192.168.10.5:4000/v1 (chat completions)
# x / xai / grok → https://api.x.ai/v1 (Responses API)
# openai → https://api.openai.com/v1
# ollama → http://127.0.0.1:11434/v1
LLM_PROVIDER=litellm
LLM_MODEL=qwen3.8-flash
LITELLM_API_KEY=
# LLM_BASE_URL=http://192.168.10.5:4000/v1
# XAI_API_KEY=
# OPENAI_API_KEY=
# LLM_API_STYLE=chat
# LLM_TIMEOUT_SECONDS=60
