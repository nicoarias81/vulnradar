# Ejemplo de variables de entorno
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx   # opcional, mejora rate limits de GitHub Search
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DB_PATH=./data/humo.db
CVE_LIST_PATH=./data/cvelistV5
SYNC_INTERVAL_MINUTES=15

# LLM — proveedor y modelo configurables (env pisa config/llm.yaml).
# Aliases: x, xai, grok, spacexai → https://api.x.ai/v1 (Responses API).
# openai → https://api.openai.com/v1 (chat completions)
# ollama → http://127.0.0.1:11434/v1
LLM_PROVIDER=x
LLM_MODEL=grok-4.7
XAI_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=
# LLM_API_STYLE=responses
# LLM_TIMEOUT_SECONDS=60
