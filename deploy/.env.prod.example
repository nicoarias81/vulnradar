# Plantilla de deploy/.env.prod — el archivo REAL vive sólo en el server (chmod 600) y no se commitea.
# Lo genera deploy/bootstrap-server.sh. Ningún valor real en este repo.

# Panel SOC (/soc). Sin SOC_PASSWORD el panel queda cerrado (no público).
SOC_USER=soc
SOC_PASSWORD=

# LLM de enriquecimiento: LiteLLM compartido de /opt/stack (red docker `internal`).
# LLM_BASE_URL lo fija el compose (http://litellm:4000/v1); acá sólo la virtual key.
LLM_PROVIDER=litellm
LLM_MODEL=qwen3.8-flash
LITELLM_API_KEY=

# Worker
SYNC_INTERVAL_MINUTES=15
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
TZ=Europe/Madrid
