# Ejemplo de variables de entorno
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx   # opcional, mejora rate limits de GitHub Search
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DB_PATH=./data/humo.db
CVE_LIST_PATH=./data/cvelistV5
SYNC_INTERVAL_MINUTES=15

# LLM — proveedor y modelo configurables (env pisa config/llm.yaml).
# litellm → http://192.168.10.5:4000/v1 (chat completions)
# x / xai / grok → https://api.x.ai/v1 (Responses API)
# openai → https://api.openai.com/v1
# ollama → http://127.0.0.1:11434/v1
LLM_PROVIDER=litellm
LLM_MODEL=qwen3.8-flash
LITELLM_API_KEY=
# LLM_BASE_URL=http://192.168.10.5:4000/v1
# XAI_API_KEY=
# OPENAI_API_KEY=
# LLM_API_STYLE=chat
# LLM_TIMEOUT_SECONDS=60
